# ── Deployment settings ──────────────────────────────────────────────────────
# cp deploy/.env.example deploy/.env, fill in, then:
#   docker compose --env-file deploy/.env up -d --build
#
# Nothing here belongs in git. deploy/.env is ignored.

# Public address of the deployed site, no trailing slash. The dashboards are
# built against this, and it is where family members open tracking links.
PUBLIC_BASE_URL=https://ecs.your-domain.com
HTTP_PORT=80

# ── Supabase — the only place data is stored ─────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the POOLER host (port 6543), not the direct connection: a restarting
# container would otherwise exhaust the project's direct connection limit.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Create the schema on first boot, and apply new migrations on later deploys.
DB_RUN_MIGRATIONS=true
DB_POOL_MAX=10

# Supabase → Project Settings → API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Service role key — server-side only. It bypasses row-level security, so it
# must never be given to a browser or committed anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# Storage → create a PUBLIC bucket with this name for chat attachments.
SUPABASE_STORAGE_BUCKET=chat-attachments

# ── Access ──────────────────────────────────────────────────────────────────
# Long random value: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origins allowed to call the API. Same-origin behind this nginx, so normally
# just the public URL.
CORS_ORIGINS=https://ecs.your-domain.com

# ── Tracking links texted to emergency contacts ─────────────────────────────
PUBLIC_TRACKING_BASE_URL=https://ecs.your-domain.com/track
TRACKING_LINK_TTL_HOURS=24

# ── SMS ─────────────────────────────────────────────────────────────────────
# 'log' writes messages to the container log instead of sending them — fine for
# a first test, but emergency contacts receive nothing. Switch to 'twilio' and
# fill in the credentials for real delivery.
SMS_PROVIDER=log
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Optional third-party APIs ───────────────────────────────────────────────
# Without a Gemini key, triage uses the offline rule-based engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Without a Maps key, hospital travel times are estimated from distance.
GOOGLE_MAPS_API_KEY=

# ── Demo data ───────────────────────────────────────────────────────────────
# Writes sample Delhi hospitals and ambulances into your Supabase database on
# boot. Set true for a test deployment that needs something to dispatch; leave
# false for real use.
SEED_DEMO_DATA=false
