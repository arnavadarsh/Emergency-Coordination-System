# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecs_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# WebSocket
WS_PORT=3001

# Google Maps (for live ETA)
GOOGLE_MAPS_API_KEY=

# Gemini (AI natural-language triage). If unset, triage uses the offline rule-based engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public ambulance tracking link (what emergency contacts receive by SMS).
# Must be reachable from a phone — the user dashboard's /track route.
PUBLIC_TRACKING_BASE_URL=http://localhost:3001/track
TRACKING_LINK_TTL_HOURS=24

# SMS gateway for emergency-contact alerts.
# Unset -> messages are written to the application log instead of being sent,
# so the whole flow still works in development.
SMS_PROVIDER=log
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Hospital selection: road travel times ────────────────────────────────────
# With GOOGLE_MAPS_API_KEY set (above), hospitals are ranked on live-traffic
# driving minutes from the Distance Matrix API. Without it, times are estimated
# from straight-line distance at the speed below — ranking still works.
TRAVEL_TIME_ASSUMED_SPEED_KMPH=35
TRAVEL_TIME_CACHE_TTL_SECONDS=120
# Distance Matrix bills per origin-destination pair; these bound one request.
TRAVEL_TIME_MAX_ORIGINS=2
TRAVEL_TIME_MAX_DESTINATIONS=12
TRAVEL_TIME_PER_MINUTE=60
TRAVEL_TIME_DAILY_REQUESTS=5000
TRAVEL_TIME_MAX_CONCURRENT=4
TRAVEL_TIME_TIMEOUT_MS=4000
TRAVEL_TIME_COOLDOWN_SECONDS=60

# ── Gemini request controls ──────────────────────────────────────────────────
# /api/triage/converse is reachable without a login, so these are what stand
# between a runaway client and an unexpected bill. Set any to 0 to disable that
# call path entirely.
GEMINI_PER_CALLER_PER_MINUTE=15
GEMINI_GLOBAL_PER_MINUTE=90
GEMINI_DAILY_REQUESTS=3000
GEMINI_DAILY_TOKENS=3000000
GEMINI_MAX_CONCURRENT=4
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_MESSAGES=40
GEMINI_MAX_TRANSCRIPT_CHARS=12000
# How long to stop calling after Gemini rejects us for quota, or errors.
GEMINI_THROTTLE_COOLDOWN_SECONDS=60
GEMINI_ERROR_COOLDOWN_SECONDS=15
# Only used to show an approximate spend on GET /api/triage/llm/usage (admin).
# Check against current pricing; set both to 0 to hide the estimate.
GEMINI_INPUT_COST_PER_MTOK=0.3
GEMINI_OUTPUT_COST_PER_MTOK=2.5

# Believe X-Forwarded-For when identifying a caller for rate limiting.
# Only enable behind a proxy you control — otherwise anyone can forge it.
RATE_LIMIT_TRUST_PROXY=false
