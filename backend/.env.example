# Backend environment. Copy to backend/.env and fill in; never commit .env.
# Every variable the backend reads is listed here. Values are placeholders.

# Application
NODE_ENV=development
PORT=3000
# Bind address. 0.0.0.0 for containers; :: for IPv6-only private networks.
HOST=0.0.0.0

# ── Database ────────────────────────────────────────────────────────────────
# Quickest local setup: a self-contained SQLite file, no Postgres needed.
# Production refuses to start with this on.
USE_SQLITE=true
# Optional: a different SQLite file (":memory:" for a throwaway run).
SQLITE_DB_PATH=

# Postgres (Supabase). DATABASE_URL wins over the DB_* fields when set.
# Use the Supabase POOLER host. SUPABASE_DB_URL is accepted as an alias.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecs_db
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Apply pending migrations at startup (single-instance deployments).
DB_RUN_MIGRATIONS=false
DB_POOL_MAX=10
DB_RETRY_ATTEMPTS=20
DB_RETRY_DELAY_MS=5000
# Write a heartbeat row this often (hours; 0 = off) so a free Supabase
# project is not paused for inactivity.
DB_KEEPALIVE_INTERVAL_HOURS=6
# Demo hospitals and ambulances. Defaults to on in development, off in
# production. Never turn on against a database with real data.
SEED_DEMO_DATA=

# ── Access ──────────────────────────────────────────────────────────────────
# Long random value: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
# Comma-separated dashboard origins allowed to call the API and open sockets.
# Required in production. Unset in development = any origin.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
# First admin on a database with no admin at all (12+ characters). Ignored once
# any admin exists; remove after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Password-guessing protection, per client IP.
AUTH_LOGIN_PER_MINUTE=10
AUTH_REGISTER_PER_HOUR=10

# ── Dispatch ────────────────────────────────────────────────────────────────
# How often waiting bookings are retried (ms; 0 = only when a unit frees up),
# and when to stop and leave a booking to an admin (minutes; admins can also
# change this at runtime from System Controls).
DISPATCH_RETRY_INTERVAL_MS=20000
DISPATCH_RETRY_MAX_AGE_MINUTES=120

# ── Chat image storage (Supabase Storage) ───────────────────────────────────
# Without these, image attachments are disabled in production (text chat works)
# and written to backend/uploads/ in development. The bucket is created for you.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chat-attachments
SUPABASE_STORAGE_PREFIX=chat
SUPABASE_STORAGE_TIMEOUT_MS=15000

# Google Maps (for live ETA)
GOOGLE_MAPS_API_KEY=

# Gemini (AI natural-language triage). If unset, triage uses the offline rule-based engine.
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public ambulance tracking link (what emergency contacts receive by SMS).
# Must be reachable from a phone — the user dashboard's /track route.
PUBLIC_TRACKING_BASE_URL=http://localhost:3001/track
TRACKING_LINK_TTL_HOURS=24

# SMS gateway for emergency-contact alerts.
# Empty -> Twilio when the TWILIO_* values are set, otherwise messages are only
# written to the application log, so the whole flow still works in development.
# 'log' forces log-only even with Twilio configured.
SMS_PROVIDER=
SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Hospital selection: road travel times ────────────────────────────────────
# With GOOGLE_MAPS_API_KEY set (above), hospitals are ranked on live-traffic
# driving minutes from the Distance Matrix API. Without it, times are estimated
# from straight-line distance at the speed below — ranking still works.
TRAVEL_TIME_ASSUMED_SPEED_KMPH=35
TRAVEL_TIME_CACHE_TTL_SECONDS=120
# Distance Matrix bills per origin-destination pair; these bound one request.
TRAVEL_TIME_MAX_ORIGINS=2
TRAVEL_TIME_MAX_DESTINATIONS=12
TRAVEL_TIME_PER_MINUTE=60
TRAVEL_TIME_DAILY_REQUESTS=5000
TRAVEL_TIME_MAX_CONCURRENT=4
TRAVEL_TIME_TIMEOUT_MS=4000
TRAVEL_TIME_COOLDOWN_SECONDS=60

# ── Gemini request controls ──────────────────────────────────────────────────
# /api/triage/converse is reachable without a login, so these are what stand
# between a runaway client and an unexpected bill. Set any to 0 to disable that
# call path entirely.
GEMINI_PER_CALLER_PER_MINUTE=15
GEMINI_GLOBAL_PER_MINUTE=90
GEMINI_DAILY_REQUESTS=3000
GEMINI_DAILY_TOKENS=3000000
GEMINI_MAX_CONCURRENT=4
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_MESSAGES=40
GEMINI_MAX_TRANSCRIPT_CHARS=12000
# How long to stop calling after Gemini rejects us for quota, or errors.
GEMINI_THROTTLE_COOLDOWN_SECONDS=60
GEMINI_ERROR_COOLDOWN_SECONDS=15
# Only used to show an approximate spend on GET /api/triage/llm/usage (admin).
# Check against current pricing; set both to 0 to hide the estimate.
GEMINI_INPUT_COST_PER_MTOK=0.3
GEMINI_OUTPUT_COST_PER_MTOK=2.5

# Believe X-Forwarded-For when identifying a caller for rate limiting.
# Only enable behind a proxy you control — otherwise anyone can forge it.
RATE_LIMIT_TRUST_PROXY=false
