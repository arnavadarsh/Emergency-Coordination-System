# ── Dependencies and build output ────────────────────────────────────────────
node_modules/
dist/
coverage/
# Vite's dependency pre-bundling cache
.vite/
*.tsbuildinfo

# ── Environment and secrets ─────────────────────────────────────────────────
# Real values live in each platform's settings or in these local files only.
# Every directory keeps a committed .env.example with placeholders.
.env
.env.*
!.env.example
*.pem
*.key

# ── Local data ──────────────────────────────────────────────────────────────
# Development SQLite databases (USE_SQLITE=true) and dev-only chat uploads.
# backend/ecs_local.db was committed in the past; see README "Security notes".
*.db
*.db-journal
backend/uploads/

# Static site assembled by deploy/build-web.sh
deploy/public/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS and editors ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
__MACOSX/
.vscode/
.idea/
*.swp
*.swo
*~
