# Build-time configuration for hospital-dashboard.
#
# Vite inlines these into the bundle when it is BUILT, not when it is served —
# so they must be present during `npm run build` (or passed as Docker build
# args). Copy to .env.production and fill in your deployed hosts.

# Backend API base, including the /api suffix.
VITE_API_URL=https://api.your-domain.com/api

# Socket.IO origin. Defaults to VITE_API_URL without the /api suffix.
VITE_SOCKET_URL=https://api.your-domain.com

# The shared sign-in screen (hosted by the user dashboard).
VITE_LOGIN_URL=https://your-domain.com

# Sub-path this app is served from, when sharing one host. Leave unset for "/".
# BASE_PATH=/hospital/
